# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Data — DVC-tracked, never to Git
data/raw/*
!data/raw/.gitkeep
!data/raw/*.dvc
data/processed/*
!data/processed/.gitkeep
!data/processed/*.dvc
data/splits/*
!data/splits/.gitkeep
!data/splits/*.dvc
!data/splits/metrics.json
!data/splits/model.pkl
!data/splits/preprocessor.pkl

# Models & artifacts
*.pkl
*.joblib
!data/splits/model.pkl
!data/splits/preprocessor.pkl
mlruns/
mlflow.db
mlartifacts/
dvc-storage/

# Generated reports
monitoring/evidently_reports/*.html

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Prefect
.prefect/

# Local tool downloads / TSDB noise (do not commit)
.tools/
data/chunks_head/
coverage.xml
data/wal/
data/queries.active
# Local Prometheus block dir (e.g. data/01K.../); not the DVC raw/processed/splits tree
data/01K*/
